# ============================================================
# Greece Chauffeur Service — Environment Configuration
# ============================================================
# Cloudflare D1 binding (DB) is defined in wrangler.jsonc.
# SECRETS are set with:  npx wrangler secret put NAME   (never commit them)
# Local development reads a gitignored `.dev.vars` file with the same names.

# ── Email (Resend) ──────────────────────────────────────────
# SECRET. Resend API key.
RESEND_API_KEY=
# Authenticated sender on a domain verified in Resend (SPF + DKIM), e.g. bookings@greecechaufferservice.com.
# A Gmail address cannot be the sender for another domain.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Greece Chauffeur Service
# Where new-inquiry alerts are delivered (defaults to the address below if unset).
BOOKING_NOTIFICATION_EMAIL=greecechauffertransfers@gmail.com
# Optional extra recipient for operational alerts (follow-up digest).
OPS_ALERT_EMAIL=
# SECRET. Signing secret of the Resend webhook (delivery / bounce tracking).
RESEND_WEBHOOK_SECRET=
# Local development only: "console" logs emails instead of sending. Never set in production.
# EMAIL_TRANSPORT=console

# ── Scheduler ───────────────────────────────────────────────
# SECRET. Bearer token required by POST /api/cron/tick (also set as GitHub secret CRON_SECRET + APP_URL).
CRON_SECRET=
# Absolute public URL, used in admin links and customer acceptance links.
APP_BASE_URL=https://greecechaufferservice.com

# ── Public site contact details (build-time; unset = hidden / falls back to quote form) ──
NEXT_PUBLIC_SITE_URL=https://greecechaufferservice.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=greecechauffertransfers@gmail.com
