{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "greece-chauffer-transfers",
	"compatibility_date": "2026-09-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, required by the adapter's caching layer
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "greece-chauffer-transfers"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "greece-chauffer-transfers-db",
			"database_id": "964e39b5-25c0-4a5b-afae-f62e182216a3"
		}
	]
}
